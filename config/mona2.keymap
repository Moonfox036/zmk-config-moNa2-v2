#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>

/* DYA Studio から作成したマクロを呼び出す `&rmacro <slot>` を定義する。
   slot は 0 〜 CONFIG_ZMK_RUNTIME_MACRO_COUNT-1 (現状 0〜7)。
   どのマクロがどのスロットに入っているかは DYA Studio のマクロ一覧で確認する。
   キーへの割り当ては DYA Studio のキーマップエディタからも行える。 */

#include <behaviors/runtime_macro.dtsi>

/* デフォルトレイヤー変更 behavior `&df`。
   DYA Studio の「OSごとのデフォルトレイヤー」から設定できるほか、
   キーマップエディタで `&df DF_SEL <layer>` / `&df DF_INC` を
   任意のキーに割り当てられる。 */

#include <behaviors/default_layer.dtsi>
#include <dt-bindings/zmk_behavior_default_layer/default_layer.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/* ZMK 側で 10 が定義済みなので警告回避のため一旦 undef */

#undef ZMK_POINTING_DEFAULT_SCRL_VAL

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

/ {
    behaviors {
        mg_set_0: behavior_mg_set_0 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 0";
        };

        mg_set_1: behavior_mg_set_1 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 1";
        };

        mg_set_2: behavior_mg_set_2 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 2";
        };
    };
};

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <175>;
    flavor = "balanced";
};

&msc {
    delay-ms = <0>;
    time-to-max-speed-ms = <0>;
    acceleration-exponent = <0>;
};

/ {
    /* ─────────────────────────────────────────────────────────────
       コンボ (DYA Studio から編集可能)

       旧 `combos { compatible = "zmk,combos"; }` はコンパイル時固定で
       DYA Studio から編集できないため、zmk-feature-runtime-combo の
       「コンパイル時デフォルト」ノードへ移行した。
       ここに書いた内容はフラッシュ直後から有効で、設定を消しても復活する。
       DYA Studio 側で編集するとそのスロットだけ上書きされ、
       Web UI の "Reset to Default" でここの値へ戻せる。

       スロット総数は CONFIG_ZMK_RUNTIME_COMBO_MAX_COMBOS (現状 16)。
       未使用スロット (2〜15) は DYA Studio から自由に追加できる。
       ────────────────────────────────────────────────────────── */

    runtime_combo_defaults {
        compatible = "cormoran,runtime-combo-defaults";

        esc {
            slot = <0>;
            display-name = "ESC";
            key-positions = <38 39>;
            require-prior-idle-ms = <125>;
            bindings = <&kp ESC>;
        };

        tab {
            slot = <1>;
            display-name = "Tab";
            key-positions = <11 12>;
            require-prior-idle-ms = <125>;
            bindings = <&kp TAB>;
        };

        shift_tab {
            slot = <2>;
            display-name = "Shift + Tab";
            key-positions = <12 13>;
            require-prior-idle-ms = <125>;
            bindings = <&kp LS(TAB)>;
        };

        mouse_l {
            slot = <3>;
            display-name = "Mouse-L";
            key-positions = <17 18>;
            require-prior-idle-ms = <125>;
            bindings = <&mkp LCLK>;
        };

        mouse_r {
            slot = <4>;
            display-name = "Mouse-R";
            key-positions = <18 19>;
            require-prior-idle-ms = <125>;
            bindings = <&mkp RCLK>;
        };

        l_alt_up_arrow {
            slot = <5>;
            display-name = "L-Alt + UP-Arrow";
            key-positions = <7 6>;
            require-prior-idle-ms = <125>;
            bindings = <&kp LA(UP_ARROW)>;
        };

        l_alt_l_arrow {
            slot = <6>;
             display-name = "L-Alt + L-Arrow";
            key-positions = <29 30>;
            require-prior-idle-ms = <125>;
            bindings = <&kp LA(LEFT_ARROW)>;
        };
    };

    /* 静的マクロ。キーマップ上で &BT0 / &screenshot などの名前で直接
       参照しているため、そのまま残している (DYA Studio 上では編集不可)。
       DYA Studio から編集したいマクロは Web UI で新規作成し、
       キーに `&rmacro <slot>` を割り当てて使う。 */

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        BT0: BT0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0 &tog_off 0>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 0>,
                <&macro_wait_time 500>,
                <&tog_on 0>;

            label = "BT0";
        };

        BT1: BT1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0 &tog_off 0>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 1>,
                <&macro_wait_time 500>,
                <&tog_on 0>;

            label = "BT1";
        };

        BT2: BT2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0 &tog_off 0>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 2>,
                <&macro_wait_time 500>,
                <&tog_on 0>;

            label = "BT2";
        };

        BT3: BT3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0 &tog_off 0>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 3>,
                <&macro_wait_time 500>,
                <&tog_on 0>;

            label = "BT3";
        };

        BT4: BT4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0 &tog_off 0>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 4>,
                <&macro_wait_time 500>,
                <&tog_on 0>;

            label = "BT4";
        };

        screenshot: screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI &kp RSHIFT>,
                <&macro_wait_time 20>,
                <&macro_tap>,
                <&kp S>,
                <&macro_release>,
                <&kp LEFT_GUI &kp RSHIFT>;

            label = "SCREENSHOT";
        };

        henkan: henkan {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 20>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "HENKAN";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        tp_repeat_mo1: tp_repeat_mo1 {
            compatible = "zmk,behavior-hold-tap";
            label = "TP_REPEAT_MO1";
            bindings = <&mo>, <&key_repeat>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // エンコーダ用 runtime-configurable sensor rotate
        // デフォルトはスクロール (cw=SCRL_DOWN, ccw=SCRL_UP)
        // DYA Studio Web UI から レイヤーごとに cw/ccw の binding を
        // kp C_VOL_UP/DN や kp LEFT/RIGHT などへ動的変更可能

        rsr_default: rsr_default {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <16>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
        };

        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };

        zfold: zfold {
            compatible = "zmk,behavior-hold-tap";
            label = "ZFOLD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "hold-preferred";
            quick-tap-ms = <150>;
            hold-while-undecided;
        };

        zfoldZ: zfoldZ {
            compatible = "zmk,behavior-tap-dance";
            label = "ZFOLDZ";
            #binding-cells = <0>;
            bindings = <&zfold LEFT_SHIFT Z>, <&kp LS(Z)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main_layer0 {
            display-name = "main_layer0";
            bindings = <
&kp Q             &kp W         &kp E         &kp R        &kp T                                    &kp Y          &kp U  &kp I      &kp O    &kp P
&kp A             &kp S         &kp D         &kp F        &kp G                       &kp TAB      &kp H          &kp J  &kp K      &kp L    &lt 4 MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V        &kp B        &lt 3 ESC      &kp DEL      &kp N          &kp M  &kp COMMA  &kp DOT  &lt 5 SLASH
&kp RCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &lt 1 LANG2  &lt 4 SPACE  &lt 2 LANG1    &lt 3 ENTER  &kp BACKSPACE                             &kp RIGHT_SHIFT
            >;

            sensor-bindings = <&rsr_default>;
        };

        symbol_layer1 {
            display-name = "symbol_layer1";
            bindings = <
&none        &kp RBKT         &kp NON_US_HASH  &none    &none                                          &kp INT3          &kp LS(NUMBER_7)  &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &kp EQUAL
&kp LA(TAB)  &kp LS(LA(TAB))  &kp SEMI         &kp SQT  &kp LS(LEFT_BRACKET)            &trans         &kp LEFT_BRACKET  &kp LS(NUMBER_4)  &kp LS(NUMBER_5)  &kp LS(NUMBER_6)  &kp LS(INT1)
&none        &none            &none            &none    &none                 &trans    &kp LS(EQUAL)  &kp LS(SLASH)     &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(INT3)
&trans       &trans           &trans           &trans   &trans                &trans    &trans         &trans                                                                  &kp LALT
            >;

            sensor-bindings = <&rsr_default>;
        };

        func_sc_layer2 {
            display-name = "func_sc_layer2";
            bindings = <
&kp LEFT_GUI      &kp F7  &kp F8  &kp F9  &kp F10                             &kp LC(Y)  &kp LC(H)     &kp LC(F)  &kp LC(S)  &kp LC(P)
&kp LALT          &kp F4  &kp F5  &kp F6  &kp F11            &kp PAUSE_BREAK  &kp LC(Z)  &kp LC(C)     &kp LC(V)  &kp LC(X)  &kp LC(S)
&kp LEFT_CONTROL  &kp F1  &kp F2  &kp F3  &kp F12  &trans    &kp PRINTSCREEN  &kp LC(A)  &kp LA(SEMI)  &none      &none      &kp LC(SPACE)
&trans            &trans  &trans  &trans  &trans   &trans    &kp ESC          &kp DEL                                        &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        number_layer3 {
            display-name = "number_layer3";
            bindings = <
&trans  &trans  &trans  &trans  &trans                             &kp SINGLE_QUOTE  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_SLASH
&trans  &trans  &trans  &trans  &trans            &kp KP_ASTERISK  &kp KP_N0         &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_MINUS
&trans  &trans  &trans  &trans  &trans  &trans    &none            &kp KP_DOT        &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_PLUS
&trans  &trans  &trans  &trans  &trans  &trans    &trans           &kp KP_N0                                          &none
            >;

            sensor-bindings = <&rsr_default>;
        };

        mouse_layer4 {
            display-name = "mouse_layer4";
            bindings = <
&kp LGUI    &kp HOME        &kp UP_ARROW    &kp END          &kp LSHFT                          &mkp MCLK  &kp PAGE_UP     &kp LG(D)       &kp PAGE_DOWN    &kp K_APP
&kp LCTRL   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &mo 5                      &trans  &none      &mkp LCLK       &kp UP_ARROW    &mkp RCLK        &mo 5
&kp LSHIFT  &none           &kp LG(P)       &kp LS(LG(S))    &kp LG(E)  &kp LEFT_ALT    &trans  &none      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp RCTRL
&kp LALT    &trans          &trans          &trans           &trans     &trans          &trans  &trans                                                      &kp RSHFT
            >;

            sensor-bindings = <&rsr_default>;
        };

        scroll_layer5 {
            display-name = "scroll_layer5";
            bindings = <
&trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &out OUT_TOG  &trans  &trans  &trans  &mo 6   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans        &trans  &trans  &trans  &mo 6   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans        &trans                          &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        ble_layer6 {
            display-name = "ble_layer6";
            bindings = <
&bt BT_CLR      &none  &none  &none  &none                           &BT0   &BT1    &BT2    &BT3    &BT4
&bt BT_CLR_ALL  &none  &BT4   &none  &none           &out OUT_TOG    &none  &trans  &trans  &trans  &none
&none           &none  &BT1   &BT2   &BT3   &none    &bootloader     &none  &trans  &trans  &none   &trans
&none           &none  &BT0   &none  &none  &none    &studio_unlock  &none                          &none
            >;

            sensor-bindings = <&rsr_default>;
        };
    };
};
